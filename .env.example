# ============================================================
# ProofFlow — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets.
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ── Database (PostgreSQL via Drizzle ORM) ──────────────────
# Provision a PostgreSQL database and paste the connection string here.
# Example: postgres://user:password@host:5432/proofflow
DATABASE_URL=

# ── Authentication ──────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=
JWT_REFRESH_SECRET=
# Token lifetimes (e.g. 15m, 7d)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend (Vite) ─────────────────────────────────────────
# Required by Vite config
VITE_PORT=5173
BASE_PATH=/

# ── Stellar / Soroban ───────────────────────────────────────
# Network: testnet | mainnet | futurenet
STELLAR_NETWORK=testnet
# RPC endpoint for the network
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Horizon API URL
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Network passphrase
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Deployed escrow contract ID (set after deployment)
PROOFFLOW_CONTRACT_ID=
# Server-side Stellar account used as fee-bump source (NOT a signing key for user funds)
# This account only covers transaction fees — it does NOT touch escrow funds
STELLAR_FEE_ACCOUNT_PUBLIC_KEY=
# The secret key for the fee account — NEVER expose this to the frontend
STELLAR_FEE_ACCOUNT_SECRET_KEY=

# ── Storage (proof attachments) ─────────────────────────────
# S3-compatible storage for proof file uploads
STORAGE_ENDPOINT=
STORAGE_BUCKET=proofflow-proofs
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1

# ── AI Verification (optional — future phase) ───────────────
# OPENAI_API_KEY=
# AI_VERIFICATION_ENABLED=false

# ── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
